<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:Svfm.App" x:Class="Svfm.App.HeaderBar">
  <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="20,12">
    <DockPanel>
      <ContentControl DockPanel.Dock="Right" Name="ActionsHost" VerticalAlignment="Center" />
      <!-- Issue #122 (N2): the one Back button of the screen, at the left; N1: the step bar after the name. -->
      <Button DockPanel.Dock="Left" Name="BackButton" Content="Back" IsVisible="False" Margin="0,0,12,0" VerticalAlignment="Center" />
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Image Source="/Assets/logo.png" Width="26" Height="26" RenderOptions.BitmapInterpolationMode="HighQuality" />
        <TextBlock Text="SIMPLE V FRAMEWORK MAKER" FontFamily="{StaticResource HeadFont}" FontSize="{StaticResource SizeTitle}" FontWeight="SemiBold" LetterSpacing="{StaticResource HeadSpacing}" VerticalAlignment="Center" />
        <TextBlock Name="Slash" Text="/" Foreground="{StaticResource FaintTextBrush}" VerticalAlignment="Center" IsVisible="False" />
        <TextBlock Name="CrumbText" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="640" />
        <app:StepBar Name="Steps" Margin="14,0,0,0" />
      </StackPanel>
    </DockPanel>
  </Border>
</UserControl>
