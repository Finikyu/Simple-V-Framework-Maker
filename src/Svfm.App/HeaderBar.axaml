<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:Svfm.App" x:Class="Svfm.App.HeaderBar">
  <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="20,12">
    <DockPanel>
      <ContentControl DockPanel.Dock="Right" Name="ActionsHost" VerticalAlignment="Center" />
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Path Stroke="{StaticResource AmberBrush}" StrokeThickness="1.8" Width="22" Height="22" Stretch="Uniform"
              Data="M12 2L20.5 7V17L12 22L3.5 17V7Z M12 7V17 M7.5 9.5L16.5 14.5 M16.5 9.5L7.5 14.5" />
        <TextBlock Text="Simple V Framework Maker" FontWeight="SemiBold" VerticalAlignment="Center" />
        <TextBlock Name="Slash" Text="/" Foreground="#4A515A" VerticalAlignment="Center" IsVisible="False" />
        <TextBlock Name="CrumbText" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="640" />
      </StackPanel>
    </DockPanel>
  </Border>
</UserControl>
