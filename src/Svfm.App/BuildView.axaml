<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:Svfm.App" x:Class="Svfm.App.BuildView" x:DataType="app:BuildVm">
  <Grid ColumnDefinitions="*,380">
    <!-- Issue #81: Back to editing stays fixed; issue #122 (N2) moved it to the left of the main header. Escape does the same. -->
    <ScrollViewer>
      <StackPanel Margin="20,20" Spacing="20" MaxWidth="940" HorizontalAlignment="Stretch">
        <!-- Issue #122: no text stands on the dotted ground; each section is one card with its label inside. -->
        <Border Classes="card">
        <StackPanel Spacing="4">
          <TextBlock Text="Review and build" FontSize="{StaticResource SizeScreen}" FontWeight="Bold" />
          <TextBlock Classes="muted" Text="{Binding Headline}" />
        </StackPanel>
        </Border>

        <Border Classes="card"><StackPanel Spacing="8">
          <TextBlock Classes="lbl" Text="WHAT THIS BUILD CONTAINS" />
          <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusControl}" ClipToBounds="True">
            <StackPanel>
              <Grid ColumnDefinitions="*,Auto" Margin="12,8"><TextBlock Classes="lbl" Text="ITEM" /><TextBlock Grid.Column="1" Classes="lbl" Text="FILES" /></Grid>
              <ScrollViewer MaxHeight="240" AutomationProperties.Name="Items in this build">
              <ItemsControl ItemsSource="{Binding ContentRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="app:ContentRow">
                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,8">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" /><TextBlock Text="{Binding Kind}" Classes="muted" /></StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Detail}" Classes="muted" FontFamily="fonts:Plex#IBM Plex Mono, Consolas, monospace" FontSize="{StaticResource SizeBody}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </Border>
          <TextBlock Classes="muted" FontSize="{StaticResource SizeBody}" Text="{Binding Summary}" />
        </StackPanel></Border>

        <Border Classes="card"><StackPanel Spacing="8">
          <TextBlock Classes="lbl" Text="FILES THE MOD WILL ADD" />
          <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusControl}" Padding="12,8">
            <ScrollViewer MaxHeight="260" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Files the mod will add">
            <ItemsControl ItemsSource="{Binding Files}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" FontFamily="fonts:Plex#IBM Plex Mono, Consolas, monospace" FontSize="{StaticResource SizeBody}" Foreground="{StaticResource SoftTextBrush}" Margin="0,4" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </ScrollViewer>
          </Border>
        </StackPanel></Border>

        <Border Classes="card"><StackPanel Spacing="8">
          <TextBlock Classes="lbl" Text="CHECKS" />
          <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusControl}" ClipToBounds="True">
            <ScrollViewer MaxHeight="360" AutomationProperties.Name="Checks">
            <ItemsControl ItemsSource="{Binding Checks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="app:CheckRow">
                  <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="12,12">
                    <Grid ColumnDefinitions="Auto,*">
                      <Ellipse Width="8" Height="8" Margin="0,8,12,0" VerticalAlignment="Top" Fill="{Binding Brush}" />
                      <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="{StaticResource SizeBody}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>
          </Border>
        </StackPanel></Border>

        <Border Classes="card"><StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock Classes="lbl" Text="DRY RUN" VerticalAlignment="Center" />
          <Button Content="Run a dry run" Command="{Binding DryRunNow}" />
          <CheckBox Content="Also check for clashes with my installed mods" IsChecked="{Binding CheckClashes}" />
        </StackPanel></Border>

        <Border Classes="card"><StackPanel Spacing="8">
          <TextBlock Classes="lbl" Text="RUN LOG" />
          <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusControl}" Padding="12,8">
            <ScrollViewer MaxHeight="240" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Run log">
            <ItemsControl ItemsSource="{Binding Log}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" FontFamily="fonts:Plex#IBM Plex Mono, Consolas, monospace" FontSize="{StaticResource SizeBody}" Foreground="{StaticResource SoftTextBrush}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </ScrollViewer>
          </Border>
        </StackPanel></Border>
      </StackPanel>
    </ScrollViewer>

    <ScrollViewer Grid.Column="1">
      <StackPanel Margin="0,20,20,20" Spacing="12">
        <Border Classes="card" Padding="20">
          <StackPanel Spacing="8">
            <TextBlock Classes="lbl" Text="OUTPUT" />
            <TextBlock Text="Mod name" FontWeight="SemiBold" />
            <TextBox Text="{Binding ModName}" />
            <TextBlock Text="Author" FontWeight="SemiBold" />
            <TextBox Text="{Binding ModAuthor}" />
            <TextBlock Text="Description" FontWeight="SemiBold" />
            <TextBox app:Spell.Check="True" Text="{Binding ModDescription}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140" />
            <TextBlock Text="File type" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBlock Text=".mgsv (SnakeBite and DMM)" Classes="muted" />
            <TextBlock Text="Version" FontWeight="SemiBold" />
            <TextBox Text="{Binding ModVersion}" />
            <TextBlock Text="File" FontWeight="SemiBold" />
            <TextBlock Text="{Binding FileName}" FontFamily="fonts:Plex#IBM Plex Mono, Consolas, monospace" FontSize="{StaticResource SizeBody}" Classes="muted" TextWrapping="Wrap" />
            <TextBlock Text="Slots used" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBlock Text="{Binding Summary}" Classes="muted" TextWrapping="Wrap" />
            <Border IsVisible="{Binding HasErrors}" Background="{StaticResource BadFillBrush}" BorderBrush="{StaticResource BadLineBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusCard}" Padding="12">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding AttentionTitle}" FontWeight="SemiBold" Foreground="{StaticResource BadTextBrush}" />
                <ScrollViewer MaxHeight="160"><ItemsControl ItemsSource="{Binding Errors}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource BadTextBrush}" Margin="0,4" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                <CheckBox IsChecked="{Binding BuildAnyway}"><TextBlock TextWrapping="Wrap" Foreground="{StaticResource BadTextBrush}" Text="Build anyway (not recommended): the mod may fail to install or crash in game." /></CheckBox>
              </StackPanel>
            </Border>
            <Button Classes="primary" Content="{Binding BuildLabel}" Command="{Binding BuildNow}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="40" />
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource GreenBrush}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Classes="card" Padding="20">
          <StackPanel Spacing="8">
            <TextBlock Classes="lbl" Text="REQUIRES" />
            <TextBlock Text="V Framework 1.7 · Infinite Heaven · IHHook" />
            <TextBlock Classes="muted" FontSize="{StaticResource SizeBody}" TextWrapping="Wrap" Text="The mod needs these installed to run." />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
