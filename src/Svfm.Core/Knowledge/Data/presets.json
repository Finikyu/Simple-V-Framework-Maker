{
 "_about": "Behaviour presets for the converter (V Framework 1.7 abilities). Sources: VF 1.7 OutfitLuaBindings.cpp, SkillAndItemParameterSystemImpl_GetSuitParam.cpp; vanilla EquipDevelopConstSetting.lua + English text. defense N copies Battle Dress grade N damage rate; lifeRecovery N copies Sneaking Suit grade N life recovery; 0 = off; VF clamps 0-9, vanilla has 6 grades, so 7-9 are untested.",
 "fields": {
  "silentFootsteps": "bool",
  "quietMovement": "bool (takes all Quiet suit params; also gives Quiet's CQC moveset in place of Snake's, so it is not purely an upgrade)",
  "sprintSpeed": "0.1-10 (stored as percent)",
  "raidenRun": "bool",
  "sprintSound": "bool",
  "dashAttack": "bool or TppDamage.ATK_* id",
  "sprintSpark": ".vfx path",
  "defense": "0-9",
  "lifeRecovery": "0-9",
  "rattleSuit": "sound switch name, hashed: nom / bony / snk / amr",
  "damageSe": "sound switch name, hashed: default / battledress"
 },
 "branchFields": {
  "camoBonusType": "vanilla camo name or playerCamoType 0-116",
  "camoBonusValues": "per material (82 MTR_* names or 1-based index); vanilla uses 0 or 50"
 },
